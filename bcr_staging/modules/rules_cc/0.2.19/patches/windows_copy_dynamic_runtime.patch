diff --git a/cc/private/rules_impl/cc_binary_impl.bzl b/cc/private/rules_impl/cc_binary_impl.bzl
index 6a33e59..cadce7a 100644
--- a/cc/private/rules_impl/cc_binary_impl.bzl
+++ b/cc/private/rules_impl/cc_binary_impl.bzl
@@ -732,7 +732,22 @@ def cc_binary_impl(ctx, additional_linkopts, force_linkstatic = False):
         libraries = []
         for linker_input in linker_inputs:
             libraries.extend(linker_input.libraries)
-        copied_runtime_dynamic_libraries = _create_dynamic_libraries_copy_actions(ctx, binary, _get_dynamic_libraries_for_runtime(is_static_mode, libraries))
+        runtime_dynamic_libraries = _get_dynamic_libraries_for_runtime(is_static_mode, libraries)
+
+        # The copy_dynamic_libraries_to_binary feature is Windows-specific, and
+        # Windows has no rpath: the loader finds a DLL only next to the module
+        # or on PATH. When the C++ runtime is linked dynamically it must be
+        # copied next to the binary too or the binary fails to start with
+        # STATUS_DLL_NOT_FOUND. cc_toolchain.dynamic_runtime_lib() only returns
+        # the runtime when static_link_cpp_runtimes is enabled, which is not the
+        # case for a toolchain that links the C++ runtime purely dynamically, so
+        # pick the runtime DLLs out of the toolchain's files instead.
+        runtime_dynamic_libraries = runtime_dynamic_libraries + [
+            f
+            for f in cc_toolchain.all_files.to_list()
+            if f.basename == "libc++.dll"
+        ]
+        copied_runtime_dynamic_libraries = _create_dynamic_libraries_copy_actions(ctx, binary, runtime_dynamic_libraries)
 
