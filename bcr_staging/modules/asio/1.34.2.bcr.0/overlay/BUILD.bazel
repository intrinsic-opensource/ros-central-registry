load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "asio",
    srcs = [
        "asio/src/asio.cpp",
        "asio/src/asio_ssl.cpp",
    ],
    hdrs = glob([
        "asio/include/**/*.hpp",
        "asio/include/**/*.ipp",
    ]),
    copts = select({
        # clang/mingw, not MSVC: force-include winsock2.h with the GCC-style
        # flag instead of cl.exe /FI so windows.h does not pull in the older
        # winsock.h first.
        "@platforms//os:windows": [
            "-include",
            "winsock2.h",
        ],
        "//conditions:default": [],
    }),
    includes = ["asio/include"],
    local_defines = [
        "ASIO_SEPARATE_COMPILATION",
    ] + select({
        "@platforms//os:windows": ["WIN32_LEAN_AND_MEAN"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = ["@openssl//:ssl"],
)
