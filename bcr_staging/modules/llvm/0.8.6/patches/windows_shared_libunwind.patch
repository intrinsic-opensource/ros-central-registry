--- a/3rd_party/llvm-project/x.x/libunwind/libunwind.BUILD.bazel
+++ b/3rd_party/llvm-project/x.x/libunwind/libunwind.BUILD.bazel
@@ -37,6 +37,15 @@ cc_library(
 
 cc_library(
     name = "libunwind",
+    # Whole-archive into the Windows self-contained libc++.dll (see
+    # libcxx.shared): consumers reference the unwinder / SEH personality
+    # routines that libc++ itself does not, so without alwayslink they are
+    # dropped and consumer DLLs fail to link. Windows-only; elsewhere libunwind
+    # stays a normal static dependency.
+    alwayslink = select({
+        "@platforms//os:windows": True,
+        "//conditions:default": False,
+    }),
     # textual_hdrs = glob([
     #     "src/*.h"
     # ]),
@@ -148,10 +157,16 @@ cc_runtime_stage0_static_library(
 # Stage1 because libunwind.so must have CRTs
 cc_runtime_stage1_shared_library(
     name = "libunwind.shared",
-    shared_lib_name = "libunwind.so.1",
-    user_link_flags = [
-        "-Wl,-soname,libunwind.so.1",
-    ],
+    # See libcxx.shared: PE/COFF has no SONAME and ld.lld rejects -soname for
+    # PE targets, so use the plain "libunwind.dll" filename on Windows.
+    shared_lib_name = select({
+        "@platforms//os:windows": "libunwind.dll",
+        "//conditions:default": "libunwind.so.1",
+    }),
+    user_link_flags = select({
+        "@platforms//os:windows": [],
+        "//conditions:default": ["-Wl,-soname,libunwind.so.1"],
+    }),
