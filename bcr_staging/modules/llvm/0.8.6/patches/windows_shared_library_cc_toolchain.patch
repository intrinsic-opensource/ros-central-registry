diff --git a/toolchain/cc_toolchain.bzl b/toolchain/cc_toolchain.bzl
index 3bb4b5c..bffdaa7 100644
--- a/toolchain/cc_toolchain.bzl
+++ b/toolchain/cc_toolchain.bzl
@@ -54,8 +54,16 @@ def cc_toolchain(name, tool_map, module_map = None, extra_args = []):
                 "@llvm//toolchain/features/runtime_library_search_directories:feature",
             ],
             "@platforms//os:macos": [],
+            # Windows omits static_link_cpp_runtimes: the C++ runtime is linked
+            # dynamically (runtimes/cxxstdlib's dynamic_runtime_lib -> libc++.dll)
+            # so libc++'s ABI symbols live once in libc++.dll instead of being
+            # statically embedded in -- and re-exported from -- every ROS DLL,
+            # which otherwise collides at link time ("<symbol> was replaced").
+            # rules_cc never links the C++ runtime into a shared library
+            # (get_cc_runtimes(is_library=True) == []), so a companion link arg
+            # (//toolchain/args/windows:link_cxx_runtime, wired into
+            # default_link_flags) adds libc++.dll to consumer link lines.
             "@platforms//os:windows": [
-                "@llvm//toolchain/features:static_link_cpp_runtimes",
                 "@llvm//toolchain/features/runtime_library_search_directories:feature",
                 "@llvm//toolchain/features:def_file",
                 "@llvm//toolchain/features:targets_windows",
@@ -105,6 +113,7 @@ def cc_toolchain(name, tool_map, module_map = None, extra_args = []):
             ],
             "@platforms//os:windows": [
                 "@llvm//toolchain:windows_executable_pattern",
+                "@llvm//toolchain:windows_dynamic_library_pattern",
             ],
             "//conditions:default": [],
         }),
