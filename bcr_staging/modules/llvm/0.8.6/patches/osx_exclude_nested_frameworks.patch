--- a/extensions/osx.bzl
+++ b/extensions/osx.bzl
@@ -155,6 +155,39 @@
     if "PrintCore" not in frameworks:
         excludes.append("usr/include/cups/*")
 
+    # RCR: umbrella frameworks (e.g. AVFoundation) bundle references to their
+    # own sub-frameworks under a nested Frameworks/ directory, often as
+    # alias/symlink-like entries in Apple's SDK archive whose file type
+    # Bazel's archive extraction can't materialize ("The file type of ...
+    # is not supported"), which fails the whole sysroot repo rather than
+    # just the framework that needed it. Compiling against a framework's own
+    # umbrella header only needs its own Headers/Modules, not its bundled
+    # sub-frameworks (those are reached via their own top-level `-F` search,
+    # same as any other framework), so it's safe to always exclude this
+    # nested directory. Real framework bundles keep their actual content under
+    # Versions/<ver>/ (with top-level entries as symlinks into it), so the
+    # nested Frameworks/ directory bsdtar actually needs to skip lives at
+    # Versions/*/Frameworks/, not directly under the .framework/ root.
+    for framework in frameworks:
+        excludes.append("System/Library/Frameworks/%s.framework/Frameworks/*" % framework)
+        excludes.append("System/Library/PrivateFrameworks/%s.framework/Frameworks/*" % framework)
+        excludes.append("System/Library/Frameworks/%s.framework/Versions/*/Frameworks/*" % framework)
+        excludes.append("System/Library/PrivateFrameworks/%s.framework/Versions/*/Frameworks/*" % framework)
+
+    # RCR: some frameworks (e.g. AVFoundation) also carry compatibility stub
+    # symlinks under Resources/ pointing at a *sibling* framework's .tbd (e.g.
+    # AVFoundation/Versions/A/Resources/libAVFAudio.tbd -> ../../../../
+    # AVFAudio.framework/...). When that sibling framework isn't in our
+    # requested list, the symlink target doesn't exist in the archive, so
+    # bsdtar happily extracts it as a broken symlink -- which Bazel's sandbox
+    # then refuses to stage as an action input ("file type ... is not
+    # supported"), breaking any action that depends on the sysroot as a
+    # whole. These stub symlinks are never needed for compilation, so exclude
+    # them unconditionally.
+    for framework in frameworks:
+        excludes.append("System/Library/Frameworks/%s.framework/Versions/*/Resources/lib*.tbd" % framework)
+        excludes.append("System/Library/PrivateFrameworks/%s.framework/Versions/*/Resources/lib*.tbd" % framework)
+
     archive_kwargs = {
         "name": "macos_sdk",
         "files": {
