--- a/extensions/osx.bzl
+++ b/extensions/osx.bzl
@@ -155,6 +155,20 @@
     if "PrintCore" not in frameworks:
         excludes.append("usr/include/cups/*")
 
+    # RCR: umbrella frameworks (e.g. AVFoundation) bundle references to their
+    # own sub-frameworks under a nested Frameworks/ directory, often as
+    # alias/symlink-like entries in Apple's SDK archive whose file type
+    # Bazel's archive extraction can't materialize ("The file type of ...
+    # is not supported"), which fails the whole sysroot repo rather than
+    # just the framework that needed it. Compiling against a framework's own
+    # umbrella header only needs its own Headers/Modules, not its bundled
+    # sub-frameworks (those are reached via their own top-level `-F` search,
+    # same as any other framework), so it's safe to always exclude this
+    # nested directory.
+    for framework in frameworks:
+        excludes.append("System/Library/Frameworks/%s.framework/Frameworks/*" % framework)
+        excludes.append("System/Library/PrivateFrameworks/%s.framework/Frameworks/*" % framework)
+
