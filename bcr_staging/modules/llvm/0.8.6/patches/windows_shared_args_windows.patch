diff --git a/toolchain/args/windows/BUILD.bazel b/toolchain/args/windows/BUILD.bazel
index 8d28a93..d2ec24a 100644
--- a/toolchain/args/windows/BUILD.bazel
+++ b/toolchain/args/windows/BUILD.bazel
@@ -1,4 +1,5 @@
 load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
+load("@rules_cc//cc/toolchains:args_list.bzl", "cc_args_list")
 
 package(default_visibility = ["//visibility:public"])
 
@@ -67,3 +68,37 @@ cc_args(
         "mingw_import_library_search_path": "//runtimes/mingw:mingw_import_libraries_directory",
     },
 )
+
+# rules_cc never links the C++ runtime into a shared library
+# (semantics.get_cc_runtimes(is_library=True) returns []), and on Linux that is
+# fine because the dynamic loader resolves libc++'s symbols at load time. PE/COFF
+# has no such lazy resolution, so a ROS DLL that uses libc++ (exceptions, operator
+# new/delete, RTTI, ...) fails to link with undefined symbols unless libc++.dll is
+# on its link line. Pass the self-contained libc++.dll (it statically absorbs
+# libc++abi + libunwind) directly; ld.lld in MinGW mode links against a DLL by
+# path and synthesizes the imports. Only wired into "complete" builds (see
+# default_link_flags) so the runtime's own link does not reference itself.
+cc_args(
+    name = "link_cxx_runtime",
+    actions = [
+        "@rules_cc//cc/toolchains/actions:link_actions",
+    ],
+    args = ["{cxx_runtime_dll}"],
+    data = ["@llvm-project//libcxx:libcxx.shared"],
+    format = {
+        "cxx_runtime_dll": "@llvm-project//libcxx:libcxx.shared",
+    },
+)
+
+# Gate the runtime link arg on the "complete" runtime stage: normal builds get
+# libc++.dll on their link line, but the runtime libraries' own links (stage0/
+# stage1) do not -- otherwise libc++.dll's link would depend on libc++.dll,
+# a dependency cycle. Referenced (as a single label) from the toolchain's
+# default_link_flags windows branch, which cannot itself hold a nested select.
+cc_args_list(
+    name = "runtime_link_flags",
+    args = select({
+        "@llvm//toolchain:runtimes_all": [":link_cxx_runtime"],
+        "//conditions:default": [],
+    }),
+)
