 cc_library(
     name = "libcxxabi",
+    # Exposed so the Windows self-contained libc++.dll (see libcxx.shared) can
+    # statically absorb the C++ ABI objects it must resolve at link time.
+    visibility = ["//visibility:public"],
+    # Whole-archive into libc++.dll: consumers (not libc++ itself) reference
+    # much of the C++ ABI -- exception machinery (__cxa_*), the RTTI base
+    # type_info vtables, the personality routine -- so without alwayslink those
+    # objects are dropped from libc++.dll and consumer DLLs fail to link. Only
+    # affects Windows, where libc++abi is linked exclusively into libc++.dll
+    # (the dynamic runtime); elsewhere it stays a normal static dependency.
+    alwayslink = select({
+        "@platforms//os:windows": True,
+        "//conditions:default": False,
+    }),
     srcs = [
         # LIBCXXABI_SOURCES
         # C++ABI files
@@ -116,6 +129,17 @@ cc_library(
         ],
         "//conditions:default": [],
     }),
+    # On Windows, _LIBCXXABI_FUNC_VIS gates the C++ ABI symbols (__cxa_*, the
+    # RTTI type_info vtables, the personality routine) on __declspec(dllexport)
+    # only while _LIBCXXABI_BUILDING_LIBRARY is defined; otherwise they resolve
+    # to dllimport. It must be local (never propagated via `defines`) so that
+    # libc++abi's own translation units export the ABI from libc++.dll while
+    # consumers keep importing it. Harmless under :windows_static, where
+    # _LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS blanks the macro entirely.
+    local_defines = select({
+        "@platforms//os:windows": ["_LIBCXXABI_BUILDING_LIBRARY"],
