+# Windows caps a process command line at 32767 characters. Vision packages that
+# pull in OpenCV compile with hundreds of -I include paths (one per SIMD-dispatch
+# virtual-include dir) and blow past that limit. compiler_param_file makes Bazel
+# write the C++ compile flags to a @params file instead of the command line, the
+# same way archive_param_file already does for archive actions. Enabled only for
+# the Windows target config via `build:windows --features=compiler_param_file`.
+cc_feature(
+    name = "compiler_param_file",
+    feature_name = "compiler_param_file",
+)
