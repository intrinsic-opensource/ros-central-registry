diff --git a/toolchain/BUILD.bazel b/toolchain/BUILD.bazel
index 00ed76d..ccbe8c3 100644
--- a/toolchain/BUILD.bazel
+++ b/toolchain/BUILD.bazel
@@ -136,7 +136,14 @@ cc_args_list(
         "@platforms//os:linux": [
             "//toolchain/args/linux:default_link_flags",
         ],
-        "@platforms//os:windows": [],
+        # Adds libc++.dll to consumer link lines so shared libraries can import
+        # the dynamically linked C++ runtime (rules_cc does not link the runtime
+        # into shared libraries). The args_list itself gates on the "complete"
+        # runtime stage so the runtime libraries' own links do not reference
+        # libc++.dll (which would be a dependency cycle).
+        "@platforms//os:windows": [
+            "//toolchain/args/windows:runtime_link_flags",
+        ],
         "@platforms//os:none": [],
     }),
 )
@@ -388,6 +395,22 @@ cc_artifact_name_pattern(
     visibility = ["//visibility:public"],
 )
 
+# Without this, cc_shared_library on Windows falls back to the generic Unix
+# "lib%{name}.so" naming. mingw's ld.lld resolves a `-l<name>` link against a
+# dependent shared library by searching for lib<name>.dll / lib<name>.dll.a /
+# lib<name>.a -- never lib<name>.so -- so every downstream target that links a
+# ROS shared library fails with "unable to find library -l<name>". Naming the
+# shared libraries lib<name>.dll lets ld.lld find them by their `-l` flag and
+# link directly against the DLL (LLD synthesizes the imports in MinGW mode), so
+# no separate import library is required.
+cc_artifact_name_pattern(
+    name = "windows_dynamic_library_pattern",
+    category = "@rules_cc//cc/toolchains/artifacts:dynamic_library",
+    extension = ".dll",
+    prefix = "lib",
+    visibility = ["//visibility:public"],
+)
+
 cc_action_type_set(
     name = "cpp_compile_actions_without_header_parsing",
     # See https://github.com/bazelbuild/rules_cc/blob/6dd2ef1fefbca004da449578c00d8ffb91a459ca/cc/toolchains/actions/BUILD#L224
