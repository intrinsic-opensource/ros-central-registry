+# rules_py's venv/unpack/shim helper tools have no Windows binaries and its
+# venv-based launcher strategy assumes a POSIX host ("TODO: Windows" upstream).
+# On Windows hosts we transparently dispatch py_library/py_binary/py_test to
+# the rules_python implementations, which fully support Windows. On all other
+# platforms behavior is unchanged.
+_IS_WINDOWS_HOST = CURRENT_PLATFORM_OS == "windows"
+
+# Attributes specific to rules_py that the rules_python implementations do not
+# understand. None are currently used by rules_py-on-Windows consumers; they
+# are dropped (empty/None values only) or rejected when set.
+_RULES_PY_ONLY_ATTRS = ["package_collisions", "resolutions", "virtual_deps"]
+
+def _strip_rules_py_only_attrs(kwargs, kind):
+    for attr in _RULES_PY_ONLY_ATTRS:
+        if kwargs.pop(attr, None):
+            fail("{} attribute '{}' is not supported on Windows hosts".format(kind, attr))
+
+def _partition_py_srcs(kwargs):
+    """Move bare non-Python resource files from srcs to data.
+
+    rules_py accepts arbitrary resource files (py.typed, *.lark, templates,
+    ...) directly in srcs; rules_python only allows .py/.py3 there and expects
+    resources in data. Only bare in-package source files are moved: target
+    references (":gen", "@repo//:x", "//pkg:x") are left in srcs untouched,
+    because a rule there may itself produce the .py main/module (e.g. a
+    genrule that emits interface_generator.py), and moving it would break
+    main resolution or drop generated modules.
+    """
+    srcs = kwargs.get("srcs", None)
+    if not srcs or type(srcs) != type([]):
+        return
+    py_srcs = []
+    resources = []
+    for src in srcs:
+        s = str(src)
+        if s.startswith(":") or s.startswith("@") or s.startswith("//"):
+            # A target reference; its output kind is unknown here. Leave it.
+            py_srcs.append(src)
+        elif s.endswith(".py") or s.endswith(".py3"):
+            py_srcs.append(src)
+        else:
+            resources.append(src)
+    if resources:
+        data = list(kwargs.get("data", None) or [])
+        seen = {_label_key(d): True for d in data}
+        kwargs["srcs"] = py_srcs
+        kwargs["data"] = data + [r for r in resources if _label_key(r) not in seen]
+
+def _label_key(value):
+    """Normalize same-package label spellings (":foo" vs "foo") for comparison."""
+    s = str(value)
+    return s[1:] if s.startswith(":") else s
+
+def py_library(name, **kwargs):
+    if _IS_WINDOWS_HOST:
+        _strip_rules_py_only_attrs(kwargs, "py_library")
+        _partition_py_srcs(kwargs)
+        _rules_python_library(name = name, **kwargs)
+        return
+    _py_library(name = name, **kwargs)
+
 py_image_layer = _py_image_layer
 
 resolutions = _resolutions
