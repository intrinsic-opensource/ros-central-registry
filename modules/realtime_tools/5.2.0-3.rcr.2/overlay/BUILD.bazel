load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

### LIBRARIES

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
}

cc_library(
    name = "realtime_tools_library",
    srcs = ["src/realtime_helpers.cpp"],
    hdrs = glob([
        "include/**/*.hpp",
        "include/**/*.h",
    ]),
    includes = ["include"],
    linkopts = select({
        ":linux_x86_64": [
            "-L/usr/lib/x86_64-linux-gnu",
            "-l:libcap.so.2",
            "-lpthread",
        ],
        ":linux_aarch64": [
            "-L/usr/lib/aarch64-linux-gnu",
            "-l:libcap.so.2",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:boost.lockfree",
    ],
)

cc_shared_library(
    name = "realtime_tools",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":realtime_tools_library"],
    deps = [":realtime_tools_library"],
)

cc_library(
    name = "thread_priority_library",
    srcs = ["src/realtime_helpers.cpp"],
    hdrs = glob([
        "include/**/*.hpp",
        "include/**/*.h",
    ]),
    includes = ["include"],
    linkopts = select({
        ":linux_x86_64": [
            "-L/usr/lib/x86_64-linux-gnu",
            "-l:libcap.so.2",
            "-lpthread",
        ],
        ":linux_aarch64": [
            "-L/usr/lib/aarch64-linux-gnu",
            "-l:libcap.so.2",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "thread_priority",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":thread_priority_library"],
    deps = [":thread_priority_library"],
)

### TRANSITIVE DYNAMIC DEPENDENCIES FOR TESTING

TEST_DEPENDENCIES = {
    ":realtime_tools": ":realtime_tools_library",
    ":thread_priority": ":thread_priority_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action": "@rclcpp_action//:rclcpp_action_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
)

