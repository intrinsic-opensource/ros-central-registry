load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

### LIBRARY

HEADERS = glob(["include/**/*.h", "include/**/*.hpp"])

DEPENDENCIES = {
    "@rmw//:rmw": "@rmw//:rmw_library"
}

cc_library(
    name = "rosidl_buffer_backend_library",
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values(),
    data = [":ament_index"],
)

cc_shared_library(
    name = "rosidl_buffer_backend",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rosidl_buffer_backend_library"],
    deps = [":rosidl_buffer_backend_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rosidl_buffer_backend"],
    visibility = ["//visibility:private"],
)

ament_index(
    name = "ament_index",
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    headers = HEADERS,
    libraries = [":rosidl_buffer_backend"],
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rmw//:ament_package",
        "@rosdistro//:ament_package",
    ]
)
