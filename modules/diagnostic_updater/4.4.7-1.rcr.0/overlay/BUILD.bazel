load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "diagnostic_updater_library",
    srcs = ["src/diagnostic_updater.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@diagnostic_msgs//:cc",
    ],
)

cc_shared_library(
    name = "diagnostic_updater",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":diagnostic_updater_library"],
    deps = [":diagnostic_updater_library"],
)

### TRANSITIVE DYNAMIC DEPS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":diagnostic_updater",
        "@rclcpp_lifecycle//:rclcpp_lifecycle",
    ],
    visibility = ["//visibility:private"],
)

### TESTS

TEST_DEPENDENCIES = DEPENDENCIES | {
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
}

cc_test(
    name = "diagnostic_updater_test",
    srcs = ["test/diagnostic_updater_test.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = TEST_DEPENDENCIES.values() + [
        ":diagnostic_updater_library",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "diagnostic_status_wrapper_test",
    srcs = ["test/diagnostic_status_wrapper_test.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = TEST_DEPENDENCIES.values() + [
        ":diagnostic_updater_library",
        "@diagnostic_msgs//:cc",
        "@std_msgs//:cc",
        "@googletest//:gtest_main",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    headers = HEADERS,
    libraries = [":diagnostic_updater"],
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@launch//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
