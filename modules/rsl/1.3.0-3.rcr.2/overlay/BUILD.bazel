load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

### GENERATE EXPORT HEADER

genrule(
    name = "generate_export_header",
    outs = ["include/rsl/export.hpp"],
    cmd = """
cat << 'EOF' > $@
#pragma once

#ifndef RSL_EXPORT
#  if defined(_MSC_VER)
#    ifdef rsl_EXPORTS
#      define RSL_EXPORT __declspec(dllexport)
#    else
#      define RSL_EXPORT __declspec(dllimport)
#    endif
#  else
#    define RSL_EXPORT __attribute__((visibility("default")))
#  endif
#endif

#ifndef RSL_NO_EXPORT
#  if defined(_MSC_VER)
#    define RSL_NO_EXPORT
#  else
#    define RSL_NO_EXPORT __attribute__((visibility("hidden")))
#  endif
#endif
EOF
""",
)

### LIBRARIES

HEADERS = glob(["include/rsl/*.hpp"])

cc_library(
    name = "rsl_library",
    srcs = [
        "src/parameter_validators.cpp",
        "src/random.cpp",
    ],
    hdrs = HEADERS + [":generate_export_header"],
    includes = ["include"],
    local_defines = ros_local_defines() + ["rsl_EXPORTS"],
    deps = [
        "@rclcpp//:rclcpp_library",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:fmt",
        "@tcb_span",
        "@rosdistro//cc:tl_expected",
    ],
)

cc_shared_library(
    name = "rsl",
    dynamic_deps = ["@rclcpp//:rclcpp"],
    exports_filter = [":rsl_library"],
    deps = [":rsl_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":rsl"],
    visibility = ["//visibility:private"],
)

### TESTS

cc_test(
    name = "test_rsl",
    srcs = [
        "tests/algorithm.cpp",
        "tests/monad.cpp",
        "tests/no_discard.cpp",
        "tests/overload.cpp",
        "tests/parameter_validators.cpp",
        "tests/queue.cpp",
        "tests/random.cpp",
        "tests/static_string.cpp",
        "tests/static_vector.cpp",
        "tests/strong_type.cpp",
        "tests/try.cpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = [
        ":rsl_library",
        "@rosdistro//cc:catch2",
        "@rosdistro//cc:catch2_main",
        "@rosdistro//cc:range-v3",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":rsl"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@tcb_span//:ament_package",
    ],
)
