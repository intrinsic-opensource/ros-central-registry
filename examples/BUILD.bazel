load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@rosidl_core_generators//:defs.bzl", "c_ros_library", "cc_proto_ros_library", "cc_ros_library", "py_ros_library")
load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# Generate .proto files for the ros_interface in ./msg/BUILD.bazel.

c_ros_library(
    name = "example_ros_c_msgs",
    deps = ["//msg:ExampleMessage"],
)

cc_ros_library(
    name = "example_ros_cc_msgs",
    deps = ["//msg:ExampleMessage"],
)

py_ros_library(
    name = "example_ros_py_msgs",
    deps = ["//msg:ExampleMessage"],
)

# Protobuf pipeline offers C++ and a typesupport adapter.

cc_proto_ros_library(
    name = "example_cc_proto",
    deps = ["//msg:ExampleMessage"],
)

# C examples (note that c_ros_library includes proto type support)

cc_binary(
    name = "example_ros_publisher_c",
    srcs = ["src/example_ros_publisher.c"],
    deps = [
        ":example_ros_c_msgs",
        "@rclc//:rclc_library",
    ],
)

cc_binary(
    name = "example_ros_subscriber_c",
    srcs = ["src/example_ros_subscriber.c"],
    deps = [
        ":example_ros_c_msgs",
        "@rclc//:rclc_library",
    ],
)

# C++ examples (note that cc_ros_library includes proto type support)

cc_binary(
    name = "example_ros_publisher_cc",
    srcs = ["src/example_ros_publisher.cc"],
    deps = [
        ":example_ros_cc_msgs",
        "@rclcpp//:rclcpp_library",
    ],
)

cc_binary(
    name = "example_ros_subscriber_cc",
    srcs = ["src/example_ros_subscriber.cc"],
    deps = [
        ":example_ros_cc_msgs",
        "@rclcpp//:rclcpp_library",
    ],
)

# Python examples

py_binary(
    name = "example_ros_publisher_py",
    srcs = ["src/example_ros_publisher.py"],
    main = "src/example_ros_publisher.py",
    deps = [
        ":example_ros_py_msgs",
        "@rclpy",
    ],
)

py_binary(
    name = "example_ros_subscriber_py",
    srcs = ["src/example_ros_subscriber.py"],
    main = "src/example_ros_subscriber.py",
    deps = [
        ":example_ros_py_msgs",
        "@rclpy",
    ],
)

# Protobuf pipeline example

cc_binary(
    name = "example_proto_publisher_cc",
    srcs = ["src/example_proto_publisher.cc"],
    deps = [
        ":example_cc_proto",
        "@rclcpp//:rclcpp_library",
    ],
)

cc_binary(
    name = "example_proto_subscriber_cc",
    srcs = ["src/example_proto_subscriber.cc"],
    deps = [
        ":example_cc_proto",
        "@rclcpp//:rclcpp_library",
    ],
)
